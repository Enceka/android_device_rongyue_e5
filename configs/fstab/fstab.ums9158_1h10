# Android fstab file for the Rongyue E5 (Unisoc UMS9621 / qogirn6lite).
#
# This is the FIRST-STAGE fstab: it is installed into the vendor ramdisk as
# first_stage_ramdisk/fstab.ums9158_1h10 and read by init from init_boot.
#
# Derived from the stock vendor ramdisk's first_stage_ramdisk/fstab.ums9158_1h10
# with two deliberate differences:
#   * system_dlkm is not listed  -> this device tree does not build that
#     partition (it only ever holds GKI system modules, which are unused here);
#   * the avb= / avb_keys= flags are dropped -> the device runs unlocked with
#     dm-verity disabled and we do not sign with the OEM key.
#
# <src>                          <mnt_point>   <type>  <mnt_flags and options>  <fs_mgr_flags>

system                          /system       erofs   ro                       wait,logical,first_stage_mount,slotselect
system                          /system       ext4    ro,barrier=1             wait,logical,first_stage_mount,slotselect
system_ext                      /system_ext   erofs   ro                       wait,logical,first_stage_mount,slotselect
vendor                          /vendor       erofs   ro                       wait,logical,first_stage_mount,slotselect
odm                             /odm          erofs   ro                       wait,logical,first_stage_mount,slotselect
product                         /product      erofs   ro                       wait,logical,first_stage_mount,slotselect
vendor_dlkm                     /vendor_dlkm  erofs   ro                       wait,logical,first_stage_mount,slotselect

/dev/block/by-name/metadata     /metadata     f2fs    nodev,noatime,nosuid     wait,formattable,first_stage_mount,check
/dev/block/by-name/metadata     /metadata     ext4    nodev,noatime,nosuid,errors=panic wait,formattable,first_stage_mount,check

# Second stage
/dev/block/by-name/userdata     /data         f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,inline_xattr,inline_data,fsync_mode=nobarrier latemount,wait,quota,check,reservedsize=128M,checkpoint=fs,formattable
/dev/block/by-name/prodnv       /mnt/vendor   ext4    noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc wait,check
/dev/block/by-name/cache        /cache        f2fs    noatime,nosuid,nodev,discard wait,check,formattable
/dev/block/by-name/cache        /cache        ext4    noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc wait,check,formattable
