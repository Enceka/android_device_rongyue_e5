#
# Reconstructed from the stock ROM's /vendor/build.prop, which is not part of
# proprietary-files.txt (the build regenerates it) and is not readable over
# adb on the stock build.  Values come from `adb shell getprop` on the device.
#

# Defaults for the persisted vendor properties (wiped on a clean install).

# --- aprservice  -  APR service ---
persist.vendor.aprservice.enabled=0

# --- audio  -  audio ---
persist.vendor.audio.boot_completed=1
persist.vendor.audio.hifi_enabled=false

# --- bl  -  bootloader ---
persist.vendor.bl.max=255

# --- bsservice  -  beacon service ---
persist.vendor.bsservice.enable=1

