# --- debug  -  debug ---
persist.vendor.debug.fp.support=false

# --- eng  -  engineering mode ---
persist.vendor.eng.jeita=1
persist.vendor.eng.reset=2
persist.vendor.eng.reset.switch=0

# --- faceid  -  face unlock ---
persist.vendor.faceid.livenessgrade=2

# --- modem  -  modem ---
persist.vendor.modem.log_dest=2
persist.vendor.modem.nr.enable=1
persist.vendor.modem.nvp=nr_

# --- powerhint  -  power hint ---
persist.vendor.powerhint.hint.enable=true

# --- radio  -  radio ---
persist.vendor.radio.airplanemode.enable=0,0
persist.vendor.radio.mdrec.simpin.cache=0
persist.vendor.radio.modem.capability=NR_TL_LF_W_G,NR_TL_LF_W_G
