persist.vendor.radio.modem.workmode=128,134
persist.vendor.radio.nitz.info.sim1=46000=中国移动=中国移动
persist.vendor.radio.phone_count=2
persist.vendor.radio.primarysim=0
persist.vendor.radio.tele.optimization=true

# --- sprd_blk_debug  -  block layer debug ---
persist.vendor.sprd_blk_debug=0

# --- sys  -  framework / system ---
persist.vendor.sys.isfirstboot=0
persist.vendor.sys.mdt.enable=1
persist.vendor.sys.modem.diag=disable
persist.vendor.sys.modem.io_limit=1
persist.vendor.sys.modem.save_dump=1
persist.vendor.sys.modemreset=1
persist.vendor.sys.single.imsstack=true
persist.vendor.sys.volte.enable=true
persist.vendor.sys.wac.enable=true
persist.vendor.sys.wcnreset=1
persist.vendor.sys.wcnstate=0

# --- sysdump  -  system dump ---
persist.vendor.sysdump=off

# --- use ---
persist.vendor.use.engpc.5g=true

# --- wcn  -  WCN (Wi-Fi / BT / FM) ---
persist.vendor.wcn.log_dest=2
