#
# Reconstructed from the stock ROM's /vendor/build.prop, which is not part of
# proprietary-files.txt (the build regenerates it) and is not readable over
# adb on the stock build.  Values come from `adb shell getprop` on the device.
#

# Device properties the vendor image used to carry in build.prop.

# --- hardware  -  HAL module lookup (hw_get_module / hw_get_module_by_class) ---
ro.hardware.audio.primary=whale
ro.hardware.dpu=unisoc
ro.hardware.gsp=unisoc
ro.hardware.hwcomposer=unisoc
ro.hardware.sensors=unisoc

# --- af  -  AudioFlinger tuning ---
ro.vendor.af.bt_fc_multiplier=1
ro.vendor.af.dup_multiplier=2
ro.vendor.af.raise_bt_thread_prio=true

# --- ag  -  audio DSP device nodes ---
ro.vendor.ag.log=/dev/audio_dsp_log
ro.vendor.ag.mem=/dev/audio_dsp_mem
ro.vendor.ag.pcm=/dev/audio_dsp_pcm

# --- arm  -  Mali EGL configuration and AFBC gralloc usage masks ---
ro.vendor.arm.egl.configs.r10_g10_b10_a2_32bit_fixed.framebuffer_target=false
ro.vendor.arm.egl.configs.r10_g10_b10_a2_32bit_fixed.hal_format=0x2b
ro.vendor.arm.egl.configs.r10_g10_b10_a2_32bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r16_g16_b16_a16_64bit_float.framebuffer_target=false
ro.vendor.arm.egl.configs.r16_g16_b16_a16_64bit_float.hal_format=0x16
ro.vendor.arm.egl.configs.r16_g16_b16_a16_64bit_float.recordable=false
ro.vendor.arm.egl.configs.r5_g6_b5_a0_16bit_fixed.framebuffer_target=true
ro.vendor.arm.egl.configs.r5_g6_b5_a0_16bit_fixed.hal_format=0x4
ro.vendor.arm.egl.configs.r5_g6_b5_a0_16bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_fixed.framebuffer_target=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_fixed.hal_format=0x2
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_yuv_special.framebuffer_target=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_yuv_special.hal_format=0x23
ro.vendor.arm.egl.configs.r8_g8_b8_a0_32bit_fixed.framebuffer_target=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_32bit_fixed.hal_format=0x2
ro.vendor.arm.egl.configs.r8_g8_b8_a0_32bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r8_g8_b8_a8_32bit_fixed.framebuffer_target=true
ro.vendor.arm.egl.configs.r8_g8_b8_a8_32bit_fixed.hal_format=0x1
ro.vendor.arm.egl.configs.r8_g8_b8_a8_32bit_fixed.recordable=true
ro.vendor.arm.gralloc.afrc_chroma_usage_flags=0x100000000000000,0x80000000000000,0x180000000000000
ro.vendor.arm.gralloc.afrc_chroma_usage_mask=0x180000000000000
ro.vendor.arm.gralloc.afrc_luma_usage_flags=0x50000000,0x60000000,0x40000000
ro.vendor.arm.gralloc.afrc_luma_usage_mask=0x70000000
ro.vendor.arm.gralloc.afrc_rgba_usage_flags=0x50000000,0x60000000,0x40000000
ro.vendor.arm.gralloc.afrc_rgba_usage_mask=0x70000000
ro.vendor.arm.gralloc.force_back_buffer_usage_flags=0x40000000000000
ro.vendor.arm.gralloc.force_back_buffer_usage_mask=0x40000000000000
ro.vendor.arm.gralloc.no_afbc_usage_flags=0x20000000
ro.vendor.arm.gralloc.no_afbc_usage_mask=0x60000000
ro.vendor.arm.gralloc.shared_access_usage_flags=0x10000000
ro.vendor.arm.gralloc.shared_access_usage_mask=0x50000000

# --- audio  -  audio HAL ---
ro.vendor.audio.whale_hal=true

# --- camera  -  camera ---
ro.vendor.camera.dualcamera_cali_time=3

# --- ch  -  slog channel device ---
ro.vendor.ch.log=/dev/slog_ch

# --- component  -  Unisoc component version label ---
ro.vendor.component.label=13--260113

# --- display  -  display (smart resolution) ---
ro.vendor.display.sr=true

# --- displayenhance  -  display enhancement ---
ro.vendor.displayenhance=true

# --- faceid  -  face unlock ---
ro.vendor.faceid.support=true

# --- fingerprint  -  fingerprint (config = vendor module name) ---
ro.vendor.fingerprint.config=microarray

# --- fps  -  frame rate support ---
ro.vendor.fps.support=false

# --- gnsschip  -  GNSS chip ---
ro.vendor.gnsschip=marlin3lite

# --- gpu  -  GPU ---
ro.vendor.gpu.boost=0

# --- keybox  -  key attestation keybox id ---
ro.vendor.keybox.id.value=SPRD

# --- ko  -  kernel module mount point ---
ro.vendor.ko.mount.point=/mnt/vendor

# --- lmk  -  low memory killer ---
ro.vendor.lmk.kill_heaviest_task_enabled=false

# --- media  -  media (Wi-Fi display) ---
ro.vendor.media.wfd.resolution=3

# --- mmi  -  factory MMI ---
ro.vendor.mmi.use.audio.whale.hal=1

# --- modem  -  modem device nodes and NV sizes ---
ro.vendor.modem.alive=/dev/spipe_nr2
ro.vendor.modem.assert=/dev/spipe_nr2
ro.vendor.modem.command=/dev/spipe_nr0
ro.vendor.modem.dev=/dev/modem
ro.vendor.modem.diag=/dev/sdiag_nr
ro.vendor.modem.eth=sipa_eth
ro.vendor.modem.fixnv_size=0x1900000
ro.vendor.modem.gnss.diag=/dev/wcn_gnss_dump
ro.vendor.modem.gnss.log=/dev/slog_gnss
ro.vendor.modem.log=/dev/slog_nr
ro.vendor.modem.loop=/dev/spipe_nr0
ro.vendor.modem.nv=/dev/snv_nr
ro.vendor.modem.nvpacket_size=0x40000
ro.vendor.modem.runnv_size=0x1B00000
ro.vendor.modem.snd=1
ro.vendor.modem.srmi.read=/dev/spipe_nr15
ro.vendor.modem.srmi.write=/dev/spipe_nr15
ro.vendor.modem.support=1
ro.vendor.modem.tmctl=/dev/sprd_time_sync
ro.vendor.modem.tmtsf=/dev/stime_ch
ro.vendor.modem.tty=/dev/stty_nr
ro.vendor.modem.wcn.count=1
ro.vendor.modem.wcn.diag=/dev/slog_wcn0
ro.vendor.modem.wcn.enable=1
ro.vendor.modem.wcn.id=1

# --- native_version  -  Unisoc native layer version ---
ro.vendor.native_version=1

# --- nightdisplay  -  night display enhancement ---
ro.vendor.nightdisplay.enhance=true

# --- phy  -  modem PHY log device ---
ro.vendor.phy.log=/dev/slog_phy

# --- radio  -  radio (modem type, IMEI SV) ---
ro.vendor.radio.imei.sv=01
ro.vendor.radio.modemtype=nr

# --- soter  -  Tencent Soter ---
ro.vendor.soter.support=false

# --- sp  -  power-management / system-processor device nodes ---
ro.vendor.sp.dev=/dev/pmsys
ro.vendor.sp.gnss.coupling=1
ro.vendor.sp.log=/dev/slog_pm

# --- tee  -  TEE (GP API support) ---
ro.vendor.tee.gpapi.support=true

# --- tui  -  trusted UI chip ---
ro.vendor.tui.chip=qogirn6l
ro.vendor.tui.support=false

# --- wcn  -  WCN (Wi-Fi / BT / FM) ---
ro.vendor.wcn.gpschip=marlin3lite
ro.vendor.wcn.hardware.etcpath=/odm/firmware
ro.vendor.wcn.hardware.product=marlin3_lite
